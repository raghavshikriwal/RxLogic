# RxLogic — Environment Variable Reference
#
# Copy this file to `.env` in the project root and fill in real values.
# Never commit the actual `.env` file — it is already listed in .gitignore.


# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLAlchemy connection string (see models/database.py).
#
# Local development: leave this variable unset entirely to fall back to an
# in-memory SQLite database — no setup required.
#
# Production: use your managed Postgres connection string (e.g. Neon).
# Prefer the *pooled* connection string (hostname ends in "-pooler") for
# the running app; use the direct connection string only for one-off
# migrations or admin tasks.
DATABASE_URL=postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<dbname>?sslmode=require&channel_binding=require


# ---------------------------------------------------------------------------
# LLM Parser — Layer 1 (Ollama)
# ---------------------------------------------------------------------------
# Connection details for a locally running Ollama instance.
#
# Only required for the "describe in words" natural-language input path.
# Structured input continues to work with Ollama absent or unreachable —
# this is the neuro-symbolic litmus test described in README Section 9.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi3:mini


# ---------------------------------------------------------------------------
# Application & Logging
# ---------------------------------------------------------------------------
# Logging verbosity. One of: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO

# Flask debug mode. Must be "false" in any shared or production environment —
# debug mode exposes an interactive debugger and stack traces to clients.
FLASK_DEBUG=false

# Port the Flask dev server binds to when run via `python app.py`.
# Render (and most PaaS providers) set this automatically in production;
# leave it unset there rather than overriding it.
PORT=5000