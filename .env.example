# RxLogic — Environment Variable Reference
#
# Copy this file to `.env` in the project root and fill in real values.
# Never commit the actual `.env` file — it is already listed in .gitignore.


# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLAlchemy connection string (see models/database.py).
#
# Local development: leave this variable unset entirely to fall back to an
# in-memory SQLite database — no setup required.
#
# Production: use your managed Postgres connection string (e.g. Neon).
# Prefer the *pooled* connection string (hostname ends in "-pooler") for
# the running app; use the direct connection string only for one-off
# migrations or admin tasks.
DATABASE_URL=postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<dbname>?sslmode=require&channel_binding=require


# ---------------------------------------------------------------------------
# LLM Parser — Layer 1 (pluggable provider)
# ---------------------------------------------------------------------------
# Only required for the "describe in words" natural-language input path.
# Structured input continues to work with no provider configured or reachable —
# this is the neuro-symbolic litmus test described in README Section 1.
#
# LLM_PROVIDER selects the backend: "ollama" (default, local) or "anthropic"
# (hosted). PRIVACY: with "anthropic", the free text a user types is sent to
# a third party. Use synthetic demonstration data only.
LLM_PROVIDER=ollama

# --- ollama (local) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi3:mini

# --- anthropic (hosted) ---
# Required when LLM_PROVIDER=anthropic. Store it as a secret in your host
# (e.g. a Render environment variable) and never commit a real key.
ANTHROPIC_API_KEY=
# Optional model override; blank uses the built-in default (claude-haiku-5-5).
ANTHROPIC_MODEL=


# ---------------------------------------------------------------------------
# Application & Logging
# ---------------------------------------------------------------------------
# Logging verbosity. One of: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO

# Flask debug mode. Must be "false" in any shared or production environment —
# debug mode exposes an interactive debugger and stack traces to clients.
FLASK_DEBUG=false

# Port the Flask dev server binds to when run via `python app.py`.
# Render (and most PaaS providers) set this automatically in production;
# leave it unset there rather than overriding it.
PORT=5000

# ---------------------------------------------------------------------------
# Knowledge governance — Task 06
# ---------------------------------------------------------------------------
# Keep legacy_development for the existing demo dataset. This is explicitly
# unreviewed development knowledge and is NOT suitable for clinical use.
# Switch to active_release only after qualified reviewers have approved
# candidates and an authorized knowledge steward has promoted a release.
# active_release fails closed when no valid active release exists; it never
# falls back to legacy JSON files.
RXLOGIC_KNOWLEDGE_MODE=legacy_development
# Optional absolute path to the knowledge directory (contains releases/ and
# active_release.json). Defaults to the repository's knowledge/ directory.
# RXLOGIC_KNOWLEDGE_ROOT=C:\path\to\RxLogic\knowledge

# ---------------------------------------------------------------------------
# Task 12 — web security and deployment hardening
# ---------------------------------------------------------------------------
# Set RXLOGIC_ENV=production on the hosted service. Production startup refuses
# weak/missing session signing keys, SQLite, and process-local rate
# limiting. Never reuse the example values; generate a unique 32+ byte secret.
RXLOGIC_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# RXLOGIC_SESSION_SIGNING_KEY=<unique-strong-random-secret-at-least-32-bytes>

# Use a managed Redis URL for shared rate limits across Gunicorn workers.
# Local development defaults to memory:// and is process-local only.
# RXLOGIC_RATE_LIMIT_STORAGE_URI=rediss://:<password>@<host>:6379/0

# Number of trusted reverse proxies in front of Gunicorn. Leave at 0 unless
# you know the exact hosting proxy chain; for one trusted proxy, set to 1.
RXLOGIC_TRUSTED_PROXY_HOPS=0
